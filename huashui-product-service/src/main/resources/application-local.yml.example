# ============================================================
# 本地敏感配置模板
#
# 用法：复制本文件为同目录下的 application-local.yml，填入自己的密码。
#      application-local.yml 已在 .gitignore 中，不会被提交到仓库。
#
#   cp application-local.yml.example application-local.yml
#
# 本仓库是公开仓库，数据库账号密码一旦提交就等于公开。
# 生产环境应由环境变量或密钥管理服务注入。
# ============================================================

spring:
  datasource:
    username: huashui
    password: 你的数据库密码
