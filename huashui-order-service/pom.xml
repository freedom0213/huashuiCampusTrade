<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.freedom.huashui</groupId>
        <artifactId>huashuiCampusTrade</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>huashui-order-service</artifactId>
    <packaging>jar</packaging>

    <name>huashui-order-service</name>
    <description>交易域：下单、订单状态机、取消与超时</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!--
          限流熔断（阶段 11）。本服务的重点是【Feign 调用的熔断降级】：
          商品服务挂掉时下单必须快速失败，不能挂着 Tomcat 线程干等 Feign 的读超时
          （等久了线程池会被拖垮，一个依赖故障演变成全站不可用）。
          规则与降级行为见 ProductInvoker / SentinelRuleConfig
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!--
          必须显式引入 AOP。@SentinelResource 靠切面生效，而 SCA 的 starter 把
          spring-boot-starter-aop 标成了 optional（不传递）。
          漏了它注解会【静默失效】：不报错、熔断永远不触发，
          只表现为「商品服务停了，下单还是要干等 Feign 超时」——
          像性能问题而不像配置缺失，最难查
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          服务间调用。本模块是整个项目里唯一发起 Feign 调用的服务：
          下单要锁商品、付款要把商品置为已售出，都必须问商品域。
          反向（product → order）刻意不做，会形成循环依赖。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!--
          ★ 必须显式引入，不能省。
          Spring Cloud 2023 的 spring-cloud-starter-openfeign 已不再传递引入负载均衡器
          （早期版本会带上 Ribbon，后来 Ribbon 被移除，改由 Spring Cloud LoadBalancer 承担）。
          少了它，启动时会直接失败：
            IllegalStateException: No Feign Client for loadBalancing defined.
            Did you forget to include spring-cloud-starter-loadbalancer?
          因为 @FeignClient(name = "huashui-product-service") 写的是服务名，
          必须有负载均衡器才能把它解析成真实 ip:port。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 消息队列：订单取消后通知商品域恢复在售 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!--
          分布式任务调度执行器。
          只引 core：执行器是「嵌在业务服务里的一段 SDK」，不是独立应用；
          调度中心（xxl-job-admin）是另一个容器，见 docker/docker-compose.yml。
        -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.freedom.huashui</groupId>
            <artifactId>huashui-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
